{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/models/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "model/gltf-binary"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/proyectos/envase-dosificador",
      "destination": "/proyectos/mecanismo-dosificador",
      "permanent": true
    },
    {
      "source": "/projects/envase-dosificador",
      "destination": "/projects/mecanismo-dosificador",
      "permanent": true
    },
    {
      "source": "/en/projects/envase-dosificador",
      "destination": "/projects/mecanismo-dosificador",
      "permanent": true
    },
    {
      "source": "/en/projects/:slug",
      "destination": "/projects/:slug",
      "permanent": true
    },
    {
      "source": "/en",
      "destination": "/",
      "permanent": true
    }
  ]
}